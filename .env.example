# ==============================================================================
# ShopMate AI — Environment Configuration Template
# ==============================================================================

# Application & Server (Cloud Run automatically injects PORT=8080)
PROJECT_NAME="ShopMate AI - Agentic Retail Assistant"
ENVIRONMENT="production"
PORT=8080
HOST="0.0.0.0"

# CORS Configuration for Production
# Comma-separated list of origins allowed to call the API (e.g., React / Next.js app)
# Use specific domains in production, or "*" for open access.
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001,https://your-shopmate-app.vercel.app"

# Security & JWT Authentication
# In production on Cloud Run, generate a secure random secret (e.g. openssl rand -hex 32)
# and store it in Google Cloud Secret Manager.
SECRET_KEY="generate-a-strong-32-byte-secret-key-here"

# Database Configuration
# Cloud Run (PostgreSQL via Cloud SQL recommended for multi-instance production):
# DATABASE_URL="postgresql://shopmate_user:strong_password@/shopmate_db?host=/cloudsql/YOUR_PROJECT_ID:YOUR_REGION:YOUR_INSTANCE"
# Local / Container ephemeral fallback:
DATABASE_URL="sqlite:///shopmate.db"

# External Product Data APIs (Amazon & eBay)
AMAZON_PRODUCT_API_KEY=""
RAINFOREST_API_KEY=""
EBAY_API_KEY=""
COUNTDOWN_API_KEY=""

# LLM & Embedding Providers (Optional: built-in deterministic fallback works out-of-the-box)
# Google Gemini API
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# OpenAI API
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Provider selection: "auto", "gemini", "openai", or "fallback"
LLM_PROVIDER="auto"
EMBEDDING_PROVIDER="auto"

# Hybrid RAG & Vector Storage Parameters
HYBRID_SEARCH_ALPHA=0.5
TOP_K_RETRIEVAL=6
TOP_K_RERANKED=3
CRITIC_MIN_GROUNDEDNESS_SCORE=0.65
ENABLE_SAFETY_GUARDRAILS=true
